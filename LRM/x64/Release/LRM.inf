;
; LRM.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System ; TODO: specify appropriate Class
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider=%ManufacturerName%
CatalogFile=LRM.cat
DriverVer = 07/16/2023,1.0.24.716
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12
LRM_Device_CoInstaller_CopyFiles = 11

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
LRM.sys  = 1,,
WdfCoInstaller01009.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%LRM.DeviceDesc%=LRM_Device, Root\LRM ; TODO: edit hw-id

[LRM_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
LRM.sys

;-------------- Service installation
[LRM_Device.NT.Services]
AddService = LRM,%SPSVCINST_ASSOCSERVICE%, LRM_Service_Inst

; -------------- LRM driver install sections
[LRM_Service_Inst]
DisplayName    = %LRM.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\LRM.sys

;
;--- LRM_Device Coinstaller installation ------
;

[LRM_Device.NT.CoInstallers]
AddReg=LRM_Device_CoInstaller_AddReg
CopyFiles=LRM_Device_CoInstaller_CopyFiles

[LRM_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller01009.dll,WdfCoInstaller"

[LRM_Device_CoInstaller_CopyFiles]
WdfCoInstaller01009.dll

[LRM_Device.NT.Wdf]
KmdfService =  LRM, LRM_wdfsect
[LRM_wdfsect]
KmdfLibraryVersion = 1.9

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "LRM Installation Disk"
LRM.DeviceDesc = "LRM Device"
LRM.SVCDESC = "LRM Service"
